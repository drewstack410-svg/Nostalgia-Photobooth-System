# PocketBase 
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Copy these to .env and set your real admin email. Restart the app after changing .env.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_USERNAME=admin

# Multi-kiosk: unique id per device 
VITE_KIOSK_ID=booth-1

# Cloudflare R2 (guest QR / digital gallery)
# Dashboard → R2 → bucket → Settings → public r2.dev URL or custom domain.
# Create an API token with Object Read & Write for this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# VITE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# VITE_R2_FOLDER=nostalgia-photobooth
#
# Bucket CORS (needed for gallery Grid/GIF on phones):
#   Allowed Origins: https://nostalgia-qr.netlify.app  (and http://localhost:5173 for dev)
#   Allowed Methods: GET, HEAD
#   Allowed Headers: *

# Cloudinary Configuration (disabled — uploads go to R2)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name

# Public gallery URL — Netlify-hosted static site that QR codes
# point at. Phones scanning the QR get a carousel + thumbnails +
# animated GIF of the session. See public/gallery/README.md for
# deployment steps. Falls back to ${origin}/gallery/ in dev (which
# only works if the phone can reach the dev machine).
VITE_GALLERY_BASE_URL=https://your-site.netlify.app

# ── Bill acceptor / payment (LumaBooth integration seam) ──
# Price for one photo session, in whole currency units (no cents).
VITE_SESSION_PRICE=100
# Currency label shown on the payment screen.
VITE_CURRENCY=PHP
# Which bill-acceptor adapter to use:
#   auto = (default) ipc inside Electron, mock in a plain browser
#   mock = dev/testing, credit injected via on-screen debug buttons
#   ipc  = listen on the electron `payment:credit` channel — fed by
#          the LumaBooth Middleware integration: electron main
#          impersonates the LumaBooth API on http://127.0.0.1:1500 and
#          each  GET /api/start?mode=print  from the middleware
#          (bill acceptor / PayMongo sale completed) credits a session.
VITE_BILL_ACCEPTOR=auto
# Port the LumaBooth-API impersonation server listens on. 1500 is the
# LumaBooth/dslrBooth convention the middleware is hardcoded to — only
# change this if the middleware is reconfigured. (Read by electron
# main, not Vite, so no VITE_ prefix.)
#LUMA_API_PORT=1500

# Forces the Payment screen's "simulate bill" dev buttons to show even
# in a packaged (non-dev) build. Use ONLY for demo/trial builds without
# real payment hardware connected yet — leave unset/false for any real
# production handoff, since guests could tap these to skip payment.
#VITE_ENABLE_PAYMENT_SIMULATOR=true

# ─── PAYMENT MIDDLEWARE (replaces the bill acceptor) ────────────────
# TWO WAYS TO CONNECT — pick one.
#
# A. PUSH (simplest; nothing below is required).
#    The middleware calls the kiosk when a sale completes:
#      POST http://127.0.0.1:1500/api/payment
#      Content-Type: application/json
#      {"status":"paid","transactionId":"abc123"}
#    Partial credit:   {"amount":50}
#    Failure:          {"status":"failed","message":"declined"}
#    Optional shared secret (sent as X-Payment-Secret):
#PAYMENT_PUSH_SECRET=
#
# B. PULL (kiosk calls the middleware and polls for the result).
#    Setting PAYMENT_API_URL turns this on. Everything else has a
#    sensible default — override only what the middleware actually does.
#PAYMENT_API_URL=http://127.0.0.1:8080
#PAYMENT_API_KEY=
#PAYMENT_API_AUTH_HEADER=Authorization
#PAYMENT_API_AUTH_SCHEME=Bearer
#
#   Endpoints ({id} is substituted with the transaction id)
#PAYMENT_CREATE_PATH=/payments/intents
#PAYMENT_STATUS_PATH=/payments/intents/{id}
#PAYMENT_CANCEL_PATH=/payments/intents/{id}/cancel
#PAYMENT_CREATE_METHOD=POST
#
#   Response mapping — dotted paths allowed ("data.attributes.status");
#   we also auto-search data/result/payment/intent/transaction wrappers.
#PAYMENT_ID_FIELD=id
#PAYMENT_STATUS_FIELD=status
#PAYMENT_PAID_VALUES=paid,succeeded,completed,success,captured
#PAYMENT_FAILED_VALUES=failed,expired,cancelled,canceled,voided,declined
#PAYMENT_QR_FIELD=qrImage,qrUrl,qr_code_url,qr
#
#   Send amount in cents instead of whole pesos
#PAYMENT_AMOUNT_MINOR_UNITS=false
#PAYMENT_POLL_MS=2000
#PAYMENT_TIMEOUT_MS=180000
#PAYMENT_CURRENCY=PHP
#
# The kiosk sends this on every create-intent so multi-booth deployments
# can attribute sales. Set a unique value per machine.
#KIOSK_ID=booth-1
